# Copy to .env to override the defaults in docker-compose.yml.

# Host port (OpenWhispr's Server URL placeholder uses 8178).
PORT=8178

# faster-whisper model size or Hugging Face repo:
# tiny, base, small, medium, large-v3, large-v3-turbo, distil-large-v3, ... (.en = English-only)
WHISPER_MODEL=large-v3-turbo

# The name to type in OpenWhispr's Model field.
SERVED_MODEL_NAME=Whisper-Large-v3-Turbo

# float16 (default), or int8_float16 to use less memory.
COMPUTE_TYPE=float16

BEAM_SIZE=5

# Silero VAD drops silence before transcribing, which avoids hallucinated text.
VAD_FILTER=true
